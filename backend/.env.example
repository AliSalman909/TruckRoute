# Copy to .env and fill in. Never commit .env.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# FreeRoute (https://freeroute.org): routing + geocoding. Free tier: 5,000 req/day, 60 req/min.
FREEROUTE_API_KEY=
FREEROUTE_BASE_URL=https://api.maps.freeroute.org/v1
FREEROUTE_PROFILE=driving-car

# Trips must start and end in these countries (ISO-3 codes, comma-separated). Empty = anywhere.
ALLOWED_COUNTRY_CODES=USA

# Type-ahead suggestions while typing (FreeRoute only matches whole words). Free, no key.
# Only fills the dropdown; picked places are still verified by FreeRoute. Empty = off.
AUTOCOMPLETE_FALLBACK_URL=https://photon.komoot.io/api/

OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Multiplier applied to car travel times (FreeRoute has no truck profile; trucks are slower).
TRUCK_DURATION_FACTOR=1.10
