# No API keys are needed in the frontend: the basemap is OpenFreeMap (free OSM vector tiles)
# and all FreeRoute calls go through the Django backend, which holds the key.

# Optional: override the MapLibre basemap style URLs.
# VITE_MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/positron
# VITE_MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark

# Leave empty in development: Vite proxies /api to http://127.0.0.1:8000.
VITE_API_BASE_URL=
